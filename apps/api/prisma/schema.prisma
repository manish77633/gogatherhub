generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SELLER
  ADMIN
  ADMIN_STAFF
}
enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}
enum ProductStatus {
  DRAFT
  PENDING
  ACTIVE
  REJECTED
  ARCHIVED
}
enum OrderStatus {
  PAYMENT_PENDING
  PLACED
  CANCELLED
  FULFILLED
}
enum SellerOrderStatus {
  NEW
  ACCEPTED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}
enum PaymentMethod {
  COD
  ONLINE
}
enum PaymentStatus {
  PENDING
  COD_DUE
  PAID
  FAILED
  REFUNDED
}

enum ContentKind {
  PAGE
  BLOG
  FAQ
  POLICY
  BANNER
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReturnStatus {
  REQUESTED
  SELLER_APPROVED
  SELLER_REJECTED
  ADMIN_REVIEW
  REFUND_PENDING
}

model User {
  supportReplies SupportReply[]
  notificationReads NotificationRead[]
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(320)
  name         String    @db.VarChar(120)
  passwordHash String
  googleSub    String?   @unique @db.VarChar(255)
  avatarUrl    String?   @db.Text
  role         Role      @default(BUYER)
  staffRoleId  String?   @db.Uuid
  staffRole    StaffRole? @relation(fields: [staffRoleId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  sessions     Session[]
  addresses    Address[]
  seller       Seller?
  orders       Order[]
  tickets      SupportTicket[]
  cartItems    CartItem[]
  wishlistItems WishlistItem[]
  recentViews RecentView[]
  reviews Review[]
  returnRequests ReturnRequest[]
}

model StaffRole {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  permissions String[]
  createdAt   DateTime @default(now())
  users       User[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Seller {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @unique @db.Uuid
  status    SellerStatus @default(PENDING)
  shopName  String       @db.VarChar(160)
  reviewReason String?   @db.VarChar(500)
  businessName String?   @db.VarChar(200)
  gstin String?         @db.VarChar(15)
  gstStatus String      @default("UNVERIFIED") @db.VarChar(30)
  bankHolderName String? @db.VarChar(160)
  bankIfsc String?      @db.VarChar(11)
  bankAccountLast4 String? @db.VarChar(4)
  bankStatus String     @default("UNVERIFIED") @db.VarChar(30)
  description String?   @db.Text
  addressLine1 String?  @db.VarChar(200)
  city String?          @db.VarChar(100)
  state String?         @db.VarChar(100)
  pincode String?       @db.VarChar(10)
  logoUrl String?       @db.Text
  bannerUrl String?     @db.Text
  isOpen Boolean       @default(true)
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id])
  products  Product[]
  orders    SellerOrder[]
  returnRequests ReturnRequest[]
  categoryRequests CategoryRequest[]
  coupons Coupon[]
  @@index([status])
}

model Category {
  id       String     @id @default(uuid()) @db.Uuid
  name     String     @db.VarChar(120)
  slug     String     @unique @db.VarChar(140)
  parentId String?    @db.Uuid
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
  @@index([parentId])
}

model CategoryRequest {
  id        String   @id @default(uuid()) @db.Uuid
  sellerId  String   @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @db.VarChar(140)
  note      String?  @db.VarChar(500)
  status    String   @default("PENDING") @db.VarChar(20)
  createdAt DateTime @default(now())
  seller    Seller   @relation(fields: [sellerId], references: [id])
  @@unique([sellerId, slug])
  @@index([status, createdAt])
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  sellerId    String        @db.Uuid
  categoryId  String        @db.Uuid
  name        String        @db.VarChar(200)
  slug        String        @unique @db.VarChar(220)
  description String        @db.Text
  seoTitle String? @db.VarChar(200)
  seoDescription String? @db.VarChar(500)
  brand       String?       @db.VarChar(160)
  tags        String[]      @default([])
  attributes  Json          @default("{}")
  status      ProductStatus @default(DRAFT)
  reviewReason String? @db.VarChar(500)
  imageUrl    String?       @db.Text
  imageUrls   String[]      @default([])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  seller      Seller        @relation(fields: [sellerId], references: [id])
  category    Category      @relation(fields: [categoryId], references: [id])
  variants    Variant[]
  wishlistItems WishlistItem[]
  recentViews RecentView[]
  reviews Review[]
  @@index([status, categoryId, createdAt])
  @@index([sellerId, status])
  @@index([sellerId, deletedAt, createdAt])
  @@index([status, deletedAt, createdAt])
  @@index([name])
}

model Variant {
  id         String      @id @default(uuid()) @db.Uuid
  productId  String      @db.Uuid
  sku        String      @unique @db.VarChar(80)
  label      String      @db.VarChar(120)
  price      Decimal     @db.Decimal(12, 2)
  compareAt  Decimal?    @db.Decimal(12, 2)
  imageUrl   String?     @db.Text
  stock      Int         @default(0)
  active     Boolean     @default(true)
  product    Product     @relation(fields: [productId], references: [id])
  orderItems OrderItem[]
  cartItems CartItem[]
  movements InventoryMovement[]
  @@index([productId, active])
}

model InventoryMovement {
  id        String   @id @default(uuid()) @db.Uuid
  variantId String   @db.Uuid
  actorId   String?  @db.Uuid
  reason    String   @db.VarChar(40)
  delta     Int
  before    Int
  after     Int
  createdAt DateTime @default(now())
  variant   Variant  @relation(fields: [variantId], references: [id])
  @@index([variantId, createdAt])
  @@index([actorId, createdAt])
}

model Address {
  id         String  @id @default(uuid()) @db.Uuid
  userId     String  @db.Uuid
  fullName   String  @db.VarChar(120)
  phone      String  @db.VarChar(20)
  line1      String  @db.VarChar(200)
  line2      String? @db.VarChar(200)
  city       String  @db.VarChar(100)
  state      String  @db.VarChar(100)
  pincode    String  @db.VarChar(10)
  isDefault  Boolean @default(false)
  user       User    @relation(fields: [userId], references: [id])
  orders     Order[]
  @@index([userId])
  @@index([userId, isDefault])
}

model ServicePincode {
  pincode     String  @id @db.VarChar(10)
  cod         Boolean @default(false)
  active      Boolean @default(true)
  shippingFee Decimal @db.Decimal(12, 2)
  codFee      Decimal @db.Decimal(12, 2)
}

model Coupon {
  sellerId String? @db.Uuid
  seller Seller? @relation(fields: [sellerId], references: [id])
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique @db.VarChar(40)
  discountAmount Decimal  @db.Decimal(12, 2)
  minSubtotal    Decimal  @default(0) @db.Decimal(12, 2)
  usageLimit     Int?
  usedCount      Int      @default(0)
  startsAt       DateTime
  expiresAt      DateTime
  active         Boolean  @default(true)
  orders         Order[]
  @@index([sellerId])
}

model Order {
  id             String        @id @default(uuid()) @db.Uuid
  orderNumber    String        @unique @db.VarChar(32)
  buyerId        String        @db.Uuid
  addressId      String        @db.Uuid
  couponId       String?       @db.Uuid
  idempotencyKey String        @db.VarChar(100)
  status         OrderStatus   @default(PLACED)
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus
  razorpayOrderId String?      @unique @db.VarChar(100)
  razorpayPaymentId String?    @unique @db.VarChar(100)
  paymentExpiresAt DateTime?
  subtotal       Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  shipping       Decimal       @default(0) @db.Decimal(12, 2)
  codFee         Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
  buyer          User          @relation(fields: [buyerId], references: [id])
  address        Address       @relation(fields: [addressId], references: [id])
  coupon         Coupon?       @relation(fields: [couponId], references: [id])
  sellerOrders   SellerOrder[]
  cancellationReason String? @db.VarChar(500)
  cancelledAt DateTime?
  @@unique([buyerId, idempotencyKey])
  @@index([buyerId, createdAt])
  @@index([createdAt])
  @@index([status, createdAt])
}

model SupportTicket {
  replies SupportReply[]
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  subject   String   @db.VarChar(160)
  message   String   @db.Text
  status    String   @default("OPEN") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  variantId String   @db.Uuid
  quantity  Int
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   Variant  @relation(fields: [variantId], references: [id])
  @@unique([userId, variantId])
  @@index([userId, updatedAt])
}

model WishlistItem {
  userId    String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
  @@id([userId, productId])
  @@index([userId, createdAt])
}

model RecentView {
  userId    String   @db.Uuid
  productId String   @db.Uuid
  viewedAt  DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
  @@id([userId, productId])
  @@index([userId, viewedAt])
}

model SellerOrder {
  id        String            @id @default(uuid()) @db.Uuid
  orderId   String            @db.Uuid
  sellerId  String            @db.Uuid
  status    SellerOrderStatus @default(NEW)
  subtotal  Decimal           @db.Decimal(12, 2)
  order     Order             @relation(fields: [orderId], references: [id])
  seller    Seller            @relation(fields: [sellerId], references: [id])
  items     OrderItem[]
  @@unique([orderId, sellerId])
  @@index([sellerId, status])
}

model OrderItem {
  id            String      @id @default(uuid()) @db.Uuid
  sellerOrderId String      @db.Uuid
  variantId     String      @db.Uuid
  productName   String      @db.VarChar(200)
  sku           String      @db.VarChar(80)
  quantity      Int
  unitPrice     Decimal     @db.Decimal(12, 2)
  lineTotal     Decimal     @db.Decimal(12, 2)
  kitGroupKey   String?     @db.VarChar(100)
  sellerOrder   SellerOrder @relation(fields: [sellerOrderId], references: [id])
  variant       Variant     @relation(fields: [variantId], references: [id])
  review        Review?
  returnRequest ReturnRequest?
}

model ReturnRequest {
  id           String       @id @default(uuid()) @db.Uuid
  orderItemId  String       @unique @db.Uuid
  buyerId      String       @db.Uuid
  sellerId     String       @db.Uuid
  reason       String       @db.VarChar(1000)
  status       ReturnStatus @default(REQUESTED)
  sellerReason String?      @db.VarChar(500)
  adminReason  String?      @db.VarChar(500)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id])
  buyer        User         @relation(fields: [buyerId], references: [id])
  seller       Seller       @relation(fields: [sellerId], references: [id])
  @@index([buyerId, createdAt])
  @@index([sellerId, status, createdAt])
}

model Review {
  id               String       @id @default(uuid()) @db.Uuid
  buyerId          String       @db.Uuid
  productId        String       @db.Uuid
  orderItemId      String       @unique @db.Uuid
  rating           Int
  title            String       @db.VarChar(160)
  body             String       @db.Text
  status           ReviewStatus @default(PENDING)
  moderationReason String?      @db.VarChar(500)
  createdAt        DateTime     @default(now())
  buyer            User         @relation(fields: [buyerId], references: [id])
  product          Product      @relation(fields: [productId], references: [id])
  orderItem        OrderItem    @relation(fields: [orderItemId], references: [id])
  @@index([productId, status, createdAt])
  @@index([buyerId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @db.Uuid
  action    String   @db.VarChar(80)
  entity    String   @db.VarChar(80)
  entityId  String   @db.VarChar(100)
  createdAt DateTime @default(now())
  @@index([actorId, createdAt])
  @@index([entity, entityId, createdAt])
}

model ContentEntry {
  id              String      @id @default(uuid()) @db.Uuid
  kind            ContentKind
  slug            String      @db.VarChar(160)
  title           String      @db.VarChar(200)
  body            String      @db.Text
  imageUrl        String?     @db.Text
  metaTitle       String?     @db.VarChar(200)
  metaDescription String?     @db.VarChar(500)
  published       Boolean     @default(false)
  publishedSnapshot Json?
  publishedSlug String? @db.VarChar(160)
  publishedAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  @@unique([kind, slug])
  @@index([kind, published, updatedAt])
}

model SupportReply {
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
  id String @id @default(uuid()) @db.Uuid
  ticketId String @db.Uuid
  authorId String @db.Uuid
  authorRole String @db.VarChar(20)
  message String @db.Text
  createdAt DateTime @default(now())
  @@index([ticketId, createdAt])
}
model NotificationRead {
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.Uuid
  notificationId String @db.VarChar(160)
  readAt DateTime @default(now())
  @@id([userId, notificationId])
}

model MediaAsset {
  id String @id @default(uuid()) @db.Uuid
  publicId String @unique @db.VarChar(255)
  url String @db.Text
  filename String @db.VarChar(255)
  altText String @default("") @db.VarChar(500)
  width Int
  height Int
  bytes Int
  format String @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([createdAt])
}

model HomepageSection {
  pageKey String @default("home") @db.VarChar(80)
  id String @id @default(uuid()) @db.Uuid
  key String @db.VarChar(80)
  draft Json @default("{}")
  published Json @default("{}")
  enabled Boolean @default(true)
  position Int @default(0)
  publishedAt DateTime?
  updatedAt DateTime @updatedAt
  @@unique([pageKey, key])
  @@index([pageKey, position])
}
