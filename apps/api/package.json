    "test:buyer-workflow": "tsx scripts/test-buyer-workflow.ts",
    "test:account-cache": "tsx scripts/test-account-cache.ts",
    "test:seller-admin-workflow": "tsx scripts/test-seller-admin-workflow.ts",
    "test:reviews": "tsx scripts/test-reviews.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@prisma/client": "^6.19.2",
    "argon2": "^0.44.0",
    "dotenv": "^18.0.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "prisma": "^6.19.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
